# Optional. With nothing set, Kodi runs in demo mode: a local database in .data/
# and a simulated wallet. `npm run wallet` writes .env.local for the Mutinynet
# test wallet. Copy this file only to go further.

# --- Public URL (used in emails and private links)
APP_URL=http://localhost:3100

# --- Lightning wallet: Nostr Wallet Connect string (Alby Hub or any NWC wallet).
# Grant only: make_invoice, lookup_invoice, pay_invoice, get_balance, get_info.
# Best as an isolated sub-wallet, so its balance is exactly what Kodi holds.
NWC_URL=
# Test network only: stand-in wallets so payouts and refunds can be watched.
TEST_LANDLORD_NWC_URL=
TEST_AGENT_NWC_URL=
TEST_TENANT_NWC_URL=
# Which chain the wallet is on: mainnet (default) or mutinynet (free test coins).
# The app refuses invoices from the other network. On mutinynet, amounts are
# scaled down 1,000 times so real rents fit in free test coins.
LIGHTNING_NETWORK=mainnet
# Production refuses to take payments without a real wallet unless this is true.
ALLOW_DEMO_WALLET=false

# --- Database: any Postgres (Neon, Supabase, Railway...). Migrations run on start.
# Unset = the embedded local database (development only).
DATABASE_URL=
# The local database starts empty. true loads sample landlords and homes
# (the automated tests use this).
SAMPLE_DATA=false

# --- Auth
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# The arbiter's password (/admin). Local default: kodi-admin.
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Test network only: show reviewer sign-ins on the page for hackathon judges:
# the arbiter password on /admin and, when both are set, a landlord on /landlord.
SHOW_REVIEWER_LOGINS=false
REVIEWER_LANDLORD_EMAIL=
REVIEWER_LANDLORD_PASSWORD=

# --- Daily jobs: GET /api/cron/daily with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Email (optional; logged to the console when unset)
RESEND_API_KEY=
EMAIL_FROM="Kodi <rent@your-domain.ng>"
